---
import Button from "./Button.astro";
import Card from "./Card.astro";
import SponsorCard from "./SponsorCard.astro";

const ticketLink =
  "https://www.eventbrite.com/e/breaking-darkness-music-festival-2026-tickets-1977786723330";
---

<section id="tickets" class="tickets-section section">
  <div class="u-container">
    <h2 class="section-heading u-font-xl">2026 Tickets & Add-Ons</h2>
    <div class="tickets-layout">
      <Button href={ticketLink} subtext="Limited edition">Early Admission Ticket + Swag Bag</Button>
      <Button href={ticketLink} subtext="20% Off — Door pricing"> Advanced Ticket </Button>
      <Button href={ticketLink} subtext="20% off — Advanced Ticket">
        4 pack advanced ticket
      </Button>
    </div>
    <ul class="addon-deck u-list-reset">
      <Card
        heading="Festival Shirt"
        imgHref="add-ons/shirt-1.png"
        caption="($18 PLUS TAX)"
        buttonUrl={ticketLink}
      />
      <Card
        heading="Heavy Worship Shirt"
        imgHref="add-ons/shirt-2.png"
        caption="($20 PLUS TAX)"
        buttonUrl={ticketLink}
      />
      <Card
        heading="Poster Kit"
        imgHref="add-ons/poster-kit.jpg"
        caption="($12 PLUS TAX)"
        buttonUrl={ticketLink}
      />
      <Card
        heading="Souvenir Lanyard"
        imgHref="add-ons/lanyard.jpg"
        caption="($8 PLUS TAX)"
        buttonUrl={ticketLink}
      />
    </ul>
  </div>
  <div class="u-container">
    <ul class="accomodation-deck">
      <SponsorCard
        imgHref="add-ons/best-western@2x.jpg"
        heading="2026 Festival Accomodation"
        caption="Breaking Darkness Music Festival attendees get 20% OFF discount room rate at Best Western in Hickory, NC (located 8 minutes from the venue). Call 828-323-1150 and mention “Breaking Darkness Music Fest” or use the following button to make your reservation:"
        sponsorUrl="https://www.bestwestern.com/en_US/book/hotel-rooms.34163.html?groupId=1L2FA3P4"
        buttonText="Book your hotel room"
        buttonSubtext="20% off rack rate"
      />
    </ul>
  </div>
</section>

<style is:global>
  .tickets-layout {
    display: flex;
    flex-wrap: wrap;
    margin: -0.5rem;
  }
  .tickets-layout .button,
  .accomodation-deck .button {
    display: flex;
    flex-direction: column;
    flex: 1 0 19rem;
    align-items: center;
    justify-content: center;
    min-height: 4.2rem;
  }
  .tickets-layout .button {
    margin: 0.5rem;
  }
  .tickets-layout .button:first-of-type {
    min-width: calc(100% - 1rem);
  }
  .addon-deck {
    display: flex;
    flex-wrap: wrap;
    margin: 0.5rem -0.5rem;
  }
  .addon-deck .card {
    margin: 0.5rem;
    flex: 1 0 auto;
    text-align: center;
  }
  @media (min-width: 500px) {
    .addon-deck .card {
      max-width: calc(50% - 1rem);
    }
  }
  @media (min-width: 1060px) {
    .addon-deck .card {
      max-width: calc(25% - 1rem);
    }
  }
  .addon-deck .card:first-of-type {
    flex: 1 1 auto;
  }
  .addon-deck .card-img {
    width: 100%;
    position: relative;
  }
  .addon-deck .button {
    font-size: var(--font-sm);
  }

  .accomodation-deck {
    padding-left: 0;
    margin-top: 0;
  }
  .accomodation-deck .button {
    max-height: 4.2rem;
  }
</style>
